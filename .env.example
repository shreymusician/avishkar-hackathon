# Copy to .env (untracked). Never commit real values.

# Port the server listens on. The ESP32 connects to ws://<laptop-ip>:PORT/ws
PORT=5000

# MongoDB Atlas connection string. Leave empty to run without history.
MONGODB_URI=
MONGODB_DB=agrirover

# Shared key the dashboard and the rover must present. Leave empty to run open
# (fine on a private hotspot, not on a shared network).
ACCESS_KEY=

# Farmer support > Mandi prices: a free data.gov.in API key. Register at https://data.gov.in, open My Account, generate
# an API key and paste it here, then restart the server. Without it the page explains this and shows no prices.
# (News needs no key. Government schemes are a reviewed list in web/src/schemes.js: no public API exists for them.)
DATA_GOV_API_KEY=

# Live camera: the rover's USB webcam is read by ffmpeg (Windows DirectShow) and shown on the Rover control page.
# The server picks a real USB camera on its own (not a virtual or built-in one); the page also has a camera picker.
# CAMERA_NAME forces one by its exact Windows name (see http://localhost:5000/api/camera/devices after signing in).
# FFMPEG_PATH is only needed if ffmpeg is not on PATH. Lower CAMERA_SIZE / CAMERA_FPS for a weak WiFi link.
CAMERA_NAME=
FFMPEG_PATH=
CAMERA_SIZE=640x480
CAMERA_FPS=15

# Accounts: set AUTH_REQUIRED=0 to run without sign-in. AUTH_SECRET signs session cookies (generated into server/data if empty).
AUTH_REQUIRED=
AUTH_SECRET=
# DEMO_LOGIN=0 removes the Demo login button (it signs anyone in to a shared demo account).
DEMO_LOGIN=
